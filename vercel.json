{
  "version": 2,
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/styles.css", "dest": "/styles.css" },
    { "src": "/app.js", "dest": "/app.js" },
    { "src": "/gsap.min.js", "dest": "/gsap.min.js" },
    { "src": "/ScrollTrigger.min.js", "dest": "/ScrollTrigger.min.js" },
    { "src": "/sabihin-mo-na.mp3", "dest": "/sabihin-mo-na.mp3" },
    { "src": "/shots.html", "dest": "/shots.html" },
    { "src": "/candles.html", "dest": "/candles.html" },
    { "src": "/traditions.html", "dest": "/traditions.html" },
    { "src": "/bills.html", "dest": "/bills.html" },
    { "src": "/flowers.html", "dest": "/flowers.html" },
    { "src": "/gifts.html", "dest": "/gifts.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
